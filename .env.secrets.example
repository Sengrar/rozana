# Copy this file to .env.secrets and fill in the value. Git ignores .env.secrets.
#
# Secret key (starts with sb_secret_): Supabase dashboard > Project Settings >
# API Keys > Secret keys. It bypasses row-level security, so only the automated
# tests (npm test) on this computer use it. Next.js and the Cloudflare build do
# not read this file. Never paste the key in chat or docs/, never give it a
# NEXT_PUBLIC_ name, and never add it to Cloudflare.
SUPABASE_SECRET_KEY=
