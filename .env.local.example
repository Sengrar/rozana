# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git. Never commit real keys, and never paste them in docs/.
#
# Only public values belong here: the Cloudflare build copies this file into
# the live site. The secret key goes in .env.secrets (see .env.secrets.example).

# Supabase project URL and publishable key (the key starts with sb_publishable_).
# Both are safe to reach the browser: row-level security decides what each user can read.
# Where to find them:
#   - Cloud project: Supabase dashboard > Project Settings > API Keys
#   - Local database: printed by `supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# The main domain (D28). Our website is on it, the app on app.<it>, and each
# shop on <shop>.<it>. On this computer use localhost:3000, then open
# http://app.localhost:3000 and http://<shop>.localhost:3000.
# Set it to "none" (or leave it empty) to run everything on one address;
# shops are then at /shop/<shop>. The live site takes this value from
# package.json ("cloudflare" > "rootDomain"), not from this file.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
